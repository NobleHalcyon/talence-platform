# Browser-safe Supabase values
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_APP_ORIGIN=http://localhost:3000

# Trusted server only
SUPABASE_SECRET_KEY=
SUPABASE_DB_URL=
DEVICE_CREDENTIAL_PEPPER=

# Auth and abuse controls
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TALENCE_AUTH_INVITE_REDIRECT_URL=
INVITATION_DEFAULT_TTL_DAYS=7

# Catalog worker (replace the example contact before any live request)
TALENCE_CATALOG_USER_AGENT=Talence-Catalog-Worker/0.2 (+https://your-domain.example/contact)
TALENCE_CATALOG_MAX_DOWNLOAD_BYTES=2000000000
TALENCE_CATALOG_REQUEST_TIMEOUT_SECONDS=30
TALENCE_CATALOG_MAXIMUM_ATTEMPTS=4
TALENCE_CATALOG_RETRY_BASE_SECONDS=0.5
TALENCE_CATALOG_METADATA_MINIMUM_INTERVAL_SECONDS=0.11
TALENCE_CATALOG_BATCH_SIZE=1000
TALENCE_CATALOG_PRICE_STALE_AFTER_HOURS=36
TALENCE_CATALOG_TEMP_DIRECTORY=
TALENCE_DATABASE_URL=

# Server-side feature guards
FEATURE_INVITATIONS_ENABLED=false
FEATURE_CATALOG_SYNC_ENABLED=false
FEATURE_DEVICE_INVENTORY_WRITES_ENABLED=false
FEATURE_SNAPSHOT_DOWNLOADS_ENABLED=false
