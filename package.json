{
  "name": "talence-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.8.0",
  "description": "Invite-only Talence collection, deck, and device platform.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=11.0.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @talence/web",
    "build": "npm run build --workspace @talence/domain && npm run build --workspace @talence/ui && npm run build --workspace @talence/contracts && npm run build --workspace @talence/web",
    "clean": "npm run clean --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present && npm run typecheck:admin",
    "test": "npm run test:unit && npm run test:contracts && npm run test:python",
    "test:unit": "npm run test --workspaces --if-present && npm run test:admin",
    "test:e2e": "npm run test:e2e --workspace @talence/web",
    "test:contracts": "npm run validate --workspace @talence/contracts",
    "test:python": "node scripts/python.mjs -m pytest services/catalog-worker/tests",
    "test:supabase": "npx supabase test db",
    "test:supabase:phase3-integration": "node supabase/tests/integration/phase3-storage-concurrency.mjs",
    "test:supabase:phase4-concurrency": "node supabase/tests/integration/phase4-deck-concurrency.mjs",
    "test:supabase:phase5-concurrency": "node supabase/tests/integration/phase5-device-concurrency.mjs",
    "test:supabase:phase6-concurrency": "node supabase/tests/integration/phase6-quota-concurrency.mjs",
    "test:supabase:phase5-storage": "node scripts/run-phase5-storage-integration.mjs",
    "test:e2e:phase5-live": "npm run test:e2e:phase5-live --workspace @talence/web",
    "test:e2e:phase6-live": "npm run test:e2e:phase6-live --workspace @talence/web",
    "test:phase5:local": "npm run test:supabase:phase5-concurrency && npm run test:supabase:phase5-storage && npm run test:e2e:phase5-live",
    "seed:private-beta": "node scripts/seed-private-beta-fixture.mjs",
    "test:seed:repeatability": "node scripts/check-seed-repeatability.mjs",
    "test:phase6:local": "node scripts/run-phase6-critical-journey.mjs",
    "db:lint": "npx supabase db lint --local --schema public,app_private,app_api --level warning --fail-on warning",
    "db:types": "node scripts/generate-database-types.mjs",
    "db:types:check": "node scripts/generate-database-types.mjs --check",
    "test:admin": "tsx --test scripts/admin/tests/admin-service.test.ts",
    "typecheck:admin": "tsc -p scripts/admin/tsconfig.json",
    "admin:bootstrap": "tsx scripts/admin/bootstrap-admin.ts",
    "admin:invite": "tsx scripts/admin/invite-user.ts",
    "admin:revoke-invite": "tsx scripts/admin/revoke-invite.ts",
    "admin:invite-status": "tsx scripts/admin/invite-status.ts",
    "lint:python": "node scripts/python.mjs -m ruff check services/catalog-worker",
    "format:python": "node scripts/python.mjs -m ruff format --check services/catalog-worker",
    "typecheck:python": "node scripts/python.mjs -m mypy services/catalog-worker/src",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "guard:architecture": "node scripts/check-architecture.mjs",
    "guard:secrets": "node scripts/check-secrets.mjs",
    "guard:release": "node scripts/check-release-hygiene.mjs",
    "guard:browser-bundle": "node scripts/check-browser-bundle-secrets.mjs",
    "guard:security-headers": "node scripts/check-production-security-headers.mjs",
    "audit:dependencies": "npm audit --omit=dev --audit-level=high",
    "audit:python": "node scripts/python.mjs -m pip_audit --local --skip-editable",
    "canon:validate": "node scripts/check-canonical-manifest.mjs",
    "ci": "npm run canon:validate && npm run guard:architecture && npm run guard:secrets && npm run guard:release && npm run audit:dependencies && npm run format:check && npm run lint && npm run typecheck && npm run test:unit && npm run test:contracts && npm run lint:python && npm run format:python && npm run typecheck:python && npm run test:python && npm run audit:python && npm run build && npm run guard:browser-bundle && npm run guard:security-headers"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.110.8",
    "next": "16.2.12",
    "pg": "8.22.0",
    "postcss": "8.5.23",
    "sharp": "0.35.3"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "@types/pg": "8.20.0",
    "prettier": "3.9.6",
    "supabase": "2.109.1",
    "tsx": "4.23.1",
    "typescript": "7.0.2"
  },
  "overrides": {
    "next": {
      ".": "$next",
      "postcss": "$postcss",
      "sharp": "$sharp"
    }
  }
}
