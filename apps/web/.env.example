# Browser-safe configuration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_APP_ORIGIN=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Trusted web server only — never prefix these with NEXT_PUBLIC_
SUPABASE_SECRET_KEY=
DEVICE_CREDENTIAL_PEPPER=
TALENCE_DEVICE_HEARTBEAT_MAX_BODY_BYTES=16384
TALENCE_DEVICE_INVENTORY_MAX_BODY_BYTES=262144
TALENCE_DEVICE_RUN_MAX_BODY_BYTES=32768
TALENCE_SNAPSHOT_SIGNED_URL_SECONDS=600
TALENCE_CATALOG_SNAPSHOT_BUCKET=catalog-snapshots
# Development and automated browser tests only. Ignored in production.
TALENCE_ENABLE_STATIC_APP_PREVIEW=
INVITATION_DEFAULT_TTL_DAYS=7

# Server-side feature guards
FEATURE_INVITATIONS_ENABLED=
FEATURE_CATALOG_SYNC_ENABLED=
FEATURE_DEVICE_INVENTORY_WRITES_ENABLED=
FEATURE_SNAPSHOT_DOWNLOADS_ENABLED=
