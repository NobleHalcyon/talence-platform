{
  "name": "@talence/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "npm run build --workspace @talence/contracts",
    "dev": "next dev",
    "prebuild": "npm run build --workspace @talence/contracts",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "pretypecheck": "npm run build --workspace @talence/contracts",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run build --workspace @talence/contracts",
    "test": "vitest run --configLoader native --pool=threads --no-file-parallelism",
    "test:watch": "vitest --configLoader native --pool=threads --no-file-parallelism",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.3",
    "@supabase/supabase-js": "2.110.8",
    "@talence/contracts": "0.1.0",
    "@talence/domain": "0.0.0",
    "@talence/ui": "0.0.0",
    "next": "16.2.12",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "1.62.0",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@types/node": "24.13.3",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.5",
    "eslint-config-next": "16.2.12",
    "jsdom": "29.1.1",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
